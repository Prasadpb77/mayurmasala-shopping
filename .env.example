# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Shop WhatsApp number in international format, no +, no spaces, e.g. 919876543210
NEXT_PUBLIC_SHOP_WHATSAPP=919876543210

# Shown in header/footer/about, edit freely
NEXT_PUBLIC_SHOP_NAME=Mayur Masala and Pooja Center
NEXT_PUBLIC_SHOP_ADDRESS=Your Shop Address, Pimpri, Pune, Maharashtra
NEXT_PUBLIC_SHOP_PHONE=+91 98765 43210

# Base URL of the deployed site, used to build tracking links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://mayurmasala.vercel.app
